# ==============================================================================
# ENVIRONMENT CONFIGURATION VARIABLES FOR AVD DEPLOYMENT
# ==============================================================================

# Load local-only values when this file is sourced by a deployment script.
CONFIG_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PRIVATE_CONFIG="${CONFIG_DIR}/private.env"
if [ -f "$PRIVATE_CONFIG" ]; then
    # shellcheck disable=SC1090
    source "$PRIVATE_CONFIG"
fi

# Global Resource Placement
export RG="rg-avd-bastion"
export LOC="australiaeast"

# Target Network Infrastructure References
export VNET="vnet-avd-core"
export SUBNET="snet-avd-compute"
export VNET_ADDRESS_PREFIX="10.0.0.0/16"
export COMPUTE_SUBNET_PREFIX="10.0.0.0/24"
export BASTION_SUBNET_PREFIX="10.0.1.0/26"

# Session Host Virtual Machine Parameters
export VM_NAME="vm-avd-host01"
export VM_SIZE="Standard_D2s_v5"
export ADMIN_USER="local-admin-2026"
# The VM administrator password is requested interactively by 02_deploy_avd_compute.sh.

# AVD Control Plane Names
export HOST_POOL_NAME="hp-avd-main"
export APP_GROUP_NAME="ag-avd-desktop"
export WORKSPACE_NAME="ws-avd-main"
